# 换行符归一化策略
#
# 背景:Windows 开发机 core.autocrlf=true 会在检出时把 LF 转成 CRLF,而
# build_runner 生成的文件(如 lib/data/db.g.dart)以 LF 写盘,两者不一致会让
# git 持续报"已修改"的假改动。此处统一由 .gitattributes 声明,不再依赖各机器
# 的 core.autocrlf 配置,保证仓库内一律存 LF、跨平台行为一致。

# 默认:让 git 自动判定文本/二进制,文本入库统一转 LF
* text=auto eol=lf

# 源码与配置:显式声明为文本并强制 LF(含 build_runner 生成的 *.g.dart)
*.dart   text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.json   text eol=lf
*.arb    text eol=lf
*.md     text eol=lf
*.xml    text eol=lf
*.kt     text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.pro    text eol=lf
*.svg    text eol=lf
*.lock   text eol=lf

# Shell 脚本必须是 LF,否则在 Linux/macOS 上无法执行
*.sh     text eol=lf

# Windows 脚本保持 CRLF
*.ps1    text eol=crlf
*.bat    text eol=crlf
*.cmd    text eol=crlf

# 二进制资源:禁止任何换行符转换与 diff
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.webp   binary
*.ttf    binary
*.otf    binary
*.woff   binary
*.woff2  binary
*.jar    binary
*.keystore binary
*.jks    binary
